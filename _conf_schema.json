{
    "send_mode": {
        "description": "输出方式：‘图片模式’会被识别为表情包；‘文件模式’发送原文件（避免手机端画质受限）。",
        "type": "string",
        "options": ["发送图片/表情包", "作为文件发送"],
        "default": "发送图片/表情包"
    },
    "enable_at_avatar": {
        "description": "是否允许在未检测到图片时，通过 @用户 获取其 QQ 头像进行处理",
        "type": "bool",
        "default": true
    },
    "max_size_mb": {
        "description": "允许处理的最大输入图片/视频大小 (MB)",
        "type": "int",
        "default": 10
    },
    "default_width": {
        "description": "视频转GIF的默认输出宽度（像素，推荐320-480之间）",
        "type": "int",
        "default": 400
    },
    "max_width": {
        "description": "视频转GIF的最大宽度上限限制，防止服务器内存溢出(OOM)",
        "type": "int",
        "default": 720
    },
    "default_fps": {
        "description": "视频转GIF的默认输出帧率（FPS，推荐10-20之间）",
        "type": "int",
        "default": 15
    },
    "napcat_media_share_path": {
        "description": "NapCat 媒体 SMB 路径",
        "type": "string",
        "hint": "仅异机 NapCat 使用。Windows 可访问的共享根目录，例如 \\\\192.168.1.34\\Docker\\NapCat。它必须映射到下方配置的容器路径。",
        "default": ""
    },
    "napcat_media_container_path": {
        "description": "NapCat 容器媒体路径",
        "type": "string",
        "hint": "仅异机 NapCat 使用。与 SMB 路径对应的 NapCat 容器内根目录，例如 /app/napcat。收到 file:// 路径时会自动映射到 SMB 路径。",
        "default": ""
    },
    "font_size": {
        "type": "int",
        "description": "套娃表情包文字大小",
        "default": 24
    },
    "bg_style": {
        "type": "string",
        "description": "套娃表情包背景色画布风格",
        "default": "white",
        "options": ["white", "black"]
    },
    "font_path": {
        "type": "string",
        "description": "自定义字体路径 (留空则系统自动匹配内置黑体)",
        "default": ""
    },
    "mirage_color_mode": {
        "description": "幻影坦克输出颜色",
        "type": "string",
        "options": ["全彩输出", "黑白输出"],
        "default": "全彩输出"
    },
    "mirage_blend_weight": {
        "description": "幻影坦克里图混合权重 (0.0-1.0)",
        "type": "float",
        "default": 0.7
    },
    "prism_it": { "description": "光棱里图色阶端点", "type": "int", "default": 32 },
    "prism_ct": { "description": "光棱表图色阶端点", "type": "int", "default": 96 },
    "prism_ic": { "description": "光棱里图对比度", "type": "int", "default": 50 },
    "prism_cc": { "description": "光棱表图对比度", "type": "int", "default": 50 },
    "prism_reverse": { "description": "光棱反向隐写", "type": "bool", "default": false },
    "default_pixel_p": { "description": "像素化默认强度", "type": "int", "default": 50 },
    "camera_device_name": { "description": "相机镜框显示的机型", "type": "string", "default": "ASTRBOT 14 ULTRA" }
}
